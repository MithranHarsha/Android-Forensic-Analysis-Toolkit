{%- macro badge(s) -%}
<span class="badge b-{{ (s or 'none')|lower|replace(' ', '-') }}">{{ s or '—' }}</span>
{%- endmacro -%}
{%- macro prov(p) -%}
<span class="prov" title="File: {{ p.file }}&#10;SHA-256: {{ p.sha256 }}&#10;Table: {{ p.table }}  rowid: {{ p.rowid }}&#10;{{ p.wal }}&#10;Method: {{ p.method }}&#10;Parser: {{ p.parser }} ({{ p.variant }}, schema match {{ p.score }})&#10;Page/offset: {{ 'not recorded (Review 2)' if p.page is none else p.page }}"><code>{{ p.file.rsplit('/',1)[-1] }}</code> › {{ p.table or '—' }}{% if p.rowid is not none %}#{{ p.rowid }}{% endif %}<br><span class="hash">sha256:{{ p.sha256[:12] }}… · {{ p.wal }}</span></span>
{%- endmacro -%}
{%- macro trunc(key) -%}
{%- set t = r.truncation.get(key) -%}
{%- if t and t[0] < t[1] %}<p class="note">Showing the first {{ '{:,}'.format(t[0]) }} of {{ '{:,}'.format(t[1]) }} rows to keep this file usable. The complete data is in <code>report.json</code> and the CSV files.</p>{% endif -%}
{%- endmacro -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Forensic Report — {{ r.meta.case_name }}</title>
<style>
:root{--bg:#f6f7f9;--panel:#fff;--ink:#1b2430;--muted:#5b6675;--line:#dfe3e9;--accent:#1f4e8c;--ok:#16794a;--ok-bg:#e3f4ea;--warn:#8a5a00;--warn-bg:#fff1d6;--bad:#a31d1d;--bad-bg:#fbe4e4;--na:#4b5563;--na-bg:#eceff3;--info:#155e75;--info-bg:#dff3f8;--code:#f0f2f6}
@media (prefers-color-scheme:dark){:root{--bg:#0f141b;--panel:#171e28;--ink:#e6ebf2;--muted:#9aa6b6;--line:#2a3442;--accent:#7db1f0;--ok:#5fd39a;--ok-bg:#12331f;--warn:#f0c26a;--warn-bg:#3a2d0c;--bad:#ff8d8d;--bad-bg:#3b1414;--na:#aab4c3;--na-bg:#222b38;--info:#78d4ea;--info-bg:#102d36;--code:#1f2733}}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
.wrap{display:flex;max-width:1500px;margin:0 auto}
nav{position:sticky;top:0;align-self:flex-start;height:100vh;overflow:auto;width:270px;flex:none;padding:24px 16px;border-right:1px solid var(--line);font-size:13.5px}
nav h2{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:0 0 10px}
nav a{display:block;padding:5px 8px;border-radius:6px;color:var(--ink);text-decoration:none}nav a:hover{background:var(--na-bg)}
main{flex:1;min-width:0;padding:28px 32px 80px}
header.top{margin-bottom:22px}header.top h1{font-size:26px;margin:0 0 4px}header.top p{margin:0;color:var(--muted)}
section{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:20px 22px;margin:0 0 20px}
section>h2{font-size:18px;margin:0 0 4px}section>h2 .n{color:var(--muted);font-weight:500;margin-right:8px}
section h3{font-size:15px;margin:22px 0 8px}
p.lead{color:var(--muted);margin:0 0 14px}p.note{color:var(--muted);font-size:13px}
.banner{border-radius:10px;padding:14px 18px;margin:0 0 20px;background:var(--warn-bg);color:var(--warn);border:1px solid var(--warn);font-size:14px}
.glance{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px;margin:14px 0}
.card{border:1px solid var(--line);border-radius:10px;padding:14px;background:var(--panel)}
.card .v{font-size:24px;font-weight:650}.card .l{font-size:11.5px;letter-spacing:.06em;color:var(--muted);text-transform:uppercase}.card .s{font-size:12.5px;color:var(--muted)}
.card.ok{border-color:var(--ok)}.card.ok .v{color:var(--ok)}.card.na{background:var(--na-bg)}.card.na .v{font-size:16px;color:var(--na);padding:5px 0}
dl.kv{display:grid;grid-template-columns:230px 1fr;gap:6px 16px;margin:0}dl.kv dt{color:var(--muted)}dl.kv dd{margin:0;word-break:break-word}
table{border-collapse:collapse;width:100%;font-size:13px}
th,td{text-align:left;padding:6px 9px;border-bottom:1px solid var(--line);vertical-align:top;overflow-wrap:break-word}
th{white-space:nowrap}td.nw{white-space:nowrap}
th{background:var(--na-bg);font-size:11.5px;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);position:sticky;top:0}
tr:hover td{background:color-mix(in srgb,var(--na-bg) 55%,transparent)}
.scroll{max-height:560px;overflow:auto;border:1px solid var(--line);border-radius:8px}
code,.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12.5px;background:var(--code);padding:1px 5px;border-radius:4px}
.hash{font-family:ui-monospace,Menlo,monospace;font-size:11.5px;color:var(--muted)}
td.hashcell{min-width:500px}td.hashcell .hash{word-break:break-all;display:block}td.hashcell .hash b{color:var(--ink);font-weight:600;margin-right:6px}
.prov{font-size:12px}
.badge{display:inline-block;padding:1px 8px;border-radius:999px;font-size:11.5px;font-weight:600;white-space:nowrap}
.b-valid,.b-active,.b-ok{background:var(--ok-bg);color:var(--ok)}.b-partial{background:var(--warn-bg);color:var(--warn)}
.b-invalid,.b-corrupted{background:var(--bad-bg);color:var(--bad)}.b-unverified{background:var(--info-bg);color:var(--info)}
.b-recovered{background:#efe1fb;color:#6b21a8}.b-none,.b-file{background:var(--na-bg);color:var(--na)}
.b-high{background:var(--ok-bg);color:var(--ok)}.b-medium{background:var(--warn-bg);color:var(--warn)}.b-low{background:var(--bad-bg);color:var(--bad)}
.b-carved-candidate{background:#ece4fb;color:#4b2e83}
.flag{color:var(--warn);font-size:12px}.del{background:var(--warn-bg)}
.filter{margin:6px 0 10px;padding:7px 10px;width:100%;max-width:340px;border:1px solid var(--line);border-radius:6px;background:var(--panel);color:var(--ink)}
.na-box{border:1px dashed var(--na);border-radius:8px;padding:12px 16px;background:var(--na-bg);color:var(--na)}
.na-box strong{color:var(--ink)}
ul.tight{margin:6px 0 0;padding-left:20px}ul.tight li{margin:4px 0}
.disc{border-left:4px solid var(--warn);padding:10px 16px;background:var(--warn-bg);color:var(--ink);border-radius:0 8px 8px 0}
@media (max-width:1000px){nav{display:none}main{padding:18px}dl.kv{grid-template-columns:1fr}}
@media print{nav{display:none}body{background:#fff}section{break-inside:avoid-page;border-color:#bbb}.scroll{max-height:none;overflow:visible}.filter{display:none}}
</style>
</head>
<body>
<div class="wrap">
<nav aria-label="Report sections">
<h2>Contents</h2>
{% for id, title in [('s1','1. Case information'),('s2','2. Examiner / tool'),('s3','3. Evidence sources'),('s4','4. Evidence hashes'),('s5','5. Acquisition summary'),('s6','6. Artifact summary'),('s7','7. Recovered deleted data'),('s8','8. Active data'),('s9','9. Partial recoveries'),('s10','10. Carved candidates'),('s11','11. Timeline'),('s12','12. Correlation findings'),('s13','13. Validation results'),('s14','14. Methodology'),('s15','15. Limitations'),('s16','16. Appendix')] %}
<a href="#{{ id }}">{{ title }}</a>
{% endfor %}
</nav>
<main>
<header class="top">
<h1>Android Forensic Examination Report</h1>
<p>{{ r.meta.case_name }} · generated {{ r.meta.generated_at }} · {{ r.meta.tool_name }} {{ r.meta.tool_version }}</p>
</header>
{% if r.recovery.performed %}
<div class="banner" style="background:var(--ok-bg);color:var(--ok);border-color:var(--ok)"><strong>Review 1 + Review 2 — deleted-data recovery performed.</strong> {{ r.meta.review_scope }}</div>
{% else %}
<div class="banner"><strong>Review 1 — forensic foundation.</strong> {{ r.meta.review_scope }}</div>
{% endif %}

<section id="s1"><h2><span class="n">1</span>Case information</h2>
<dl class="kv">
<dt>Case name</dt><dd>{{ r.meta.case_name }}</dd><dt>Case ID</dt><dd class="mono">{{ r.meta.case_id }}</dd>
<dt>Description</dt><dd>{{ r.meta.description|cell }}</dd><dt>Case created (UTC)</dt><dd>{{ r.meta.created_at }}</dd>
<dt>Report generated (UTC)</dt><dd>{{ r.meta.generated_at }}</dd>
</dl>
<h3>Evidence at a glance</h3>
<div class="glance">
{% for g in r.at_a_glance %}<div class="card {{ g.state }}"><div class="l">{{ g.label }}</div><div class="v">{{ g.value if g.value is string else '{:,}'.format(g.value) }}</div><div class="s">{{ g.note }}</div></div>{% endfor %}
</div>
<p class="note">Categories are never merged: active records, recovered deleted records, partial recoveries, carved candidates and unrecoverable data are reported separately.{% if not r.recovery.performed %} Only ACTIVE data exists until Review 2's recovery stages are run.{% endif %}</p>
</section>

<section id="s2"><h2><span class="n">2</span>Examiner and tool information</h2>
<dl class="kv">
<dt>Examiner</dt><dd>{{ r.meta.examiner|cell }}</dd><dt>Tool</dt><dd>{{ r.meta.tool_name }} {{ r.meta.tool_version }}</dd>
<dt>Python</dt><dd>{{ r.meta.python }}</dd><dt>SQLite library</dt><dd>{{ r.meta.sqlite_library }}</dd><dt>Platform</dt><dd>{{ r.meta.platform }}</dd>
</dl></section>

<section id="s3"><h2><span class="n">3</span>Evidence sources</h2>
<div class="scroll"><table><thead><tr><th>#</th><th>Original path / container hash</th><th>Type</th><th>Files</th><th>Bytes</th><th>Acquisition time</th><th>Ingested (UTC)</th><th>Complete</th></tr></thead><tbody>
{% for s in r.sources %}<tr><td>s{{ s.id }}</td><td>{{ s.original_path }}{% if s.container_sha256 %}<br><span class="hash">container SHA-256 {{ s.container_sha256 }}</span>{% endif %}</td><td class="nw">{{ s.source_type }}</td><td class="nw">{{ '{:,}'.format(s.file_count) }}</td><td class="nw">{{ s.total_bytes|fmtbytes }}</td><td class="nw">{{ s.acquisition_time|cell }}</td><td class="nw">{{ s.ingested_at }}</td><td class="nw">{{ badge('VALID' if s.complete else 'INVALID') }}</td></tr>{% endfor %}
</tbody></table></div></section>

<section id="s4"><h2><span class="n">4</span>Evidence hashes</h2>
<p class="lead">SHA-256 is the integrity anchor; SHA-1 and MD5 are recorded for compatibility with legacy reference sets only. The complete list is in <code>evidence_manifest.json</code>, <code>report.json</code> and <code>csv/evidence_files.csv</code>.</p>
<input class="filter" placeholder="Filter files…" oninput="ftab(this,'t-hash')">
<div class="scroll"><table id="t-hash"><thead><tr><th>Path</th><th>Kind</th><th>Size</th><th>Hashes</th><th>Modified</th></tr></thead><tbody>
{% for f in r.evidence_files[:r.html_row_cap] %}<tr><td>{{ f.path }}</td><td class="nw">{{ f.kind }}</td><td class="nw">{{ '{:,}'.format(f.size) }}</td><td class="hashcell"><span class="hash"><b>SHA-256</b>{{ f.sha256 }}</span><span class="hash"><b>SHA-1</b>{{ f.sha1 }}</span><span class="hash"><b>MD5</b>{{ f.md5 }}</span></td><td class="hash nw">{{ f.mtime|cell }}</td></tr>{% endfor %}
</tbody></table></div>{{ trunc('evidence_files') }}</section>

<section id="s5"><h2><span class="n">5</span>Acquisition summary</h2>
<dl class="kv">
<dt>Files hashed</dt><dd>{{ '{:,}'.format(r.acquisition.files) }} ({{ r.acquisition.bytes|fmtbytes }})</dd>
<dt>Write-protected working copies</dt><dd>{{ r.acquisition.preserved_copies }}</dd>
<dt>Acquisition complete</dt><dd>{{ badge('VALID' if r.acquisition.all_complete else 'INVALID') }}</dd>
<dt>Detected layout</dt><dd>{{ r.acquisition.layout|cell }}{% for sid, l in r.acquisition.layout_detail.items() %}<br><span class="note">source s{{ sid }}: {{ l.detail }}</span>{% endfor %}</dd>
<dt>Skipped / flagged entries</dt><dd>{% if r.acquisition.issue_counts %}{% for k,v in r.acquisition.issue_counts.items() %}{{ k }}×{{ v }}{% if not loop.last %}, {% endif %}{% endfor %}{% else %}none{% endif %}</dd>
</dl>
<h3>File kinds</h3>
<table style="max-width:420px"><thead><tr><th>Kind</th><th>Files</th></tr></thead><tbody>{% for k,v in r.acquisition.kinds.items() %}<tr><td>{{ k }}</td><td>{{ '{:,}'.format(v) }}</td></tr>{% endfor %}</tbody></table>
<h3>Android application directories</h3>
{% if r.app_directories %}<div class="scroll"><table><thead><tr><th>Package</th><th>Android path</th><th>Area</th><th>User</th><th>Files</th><th>Databases</th><th>Subdirectories</th></tr></thead><tbody>
{% for a in r.app_directories %}<tr><td>{{ a.package }}{% if a.known_app %}<br><span class="note">{{ a.known_app }}</span>{% endif %}</td><td>{{ (a.logical_path or a.path) }}</td><td>{{ a.area|cell }}</td><td>{{ a.user_id|cell }}</td><td class="nw">{{ '{:,}'.format(a.file_count) }}</td><td>{{ a.database_count }}</td><td class="hash">{{ a.subdirectories|join(', ') }}</td></tr>{% endfor %}
</tbody></table></div>{% else %}<p class="note">No application directories were identified (the evidence may use a layout without /data/data or similar roots).</p>{% endif %}
<h3>SQLite databases</h3>
<div class="scroll"><table><thead><tr><th>Database</th><th>Application</th><th>Detection</th><th>Sidecars</th><th>Engine open</th><th>Integrity</th><th>Page size</th><th>Mode</th><th>Tables</th><th>Artifacts</th><th>Notes</th></tr></thead><tbody>
{% for d in r.databases %}<tr><td>{{ d.path }}<br><span class="hash">{{ '{:,}'.format(d.size) }} B · sha256:{{ d.sha256[:16] }}…</span></td><td>{{ d.package|cell }}</td><td>{{ badge('VALID' if d.sqlite_status=='VALID' else ('UNVERIFIED' if d.sqlite_status in ('UNVERIFIED','ENCRYPTED_SUSPECT') else 'INVALID')) }} {{ d.sqlite_status }}</td><td class="note">{% set sc = [] %}{% if d.wal %}{% set _ = sc.append('WAL ' ~ '{:,}'.format(d.wal.size) ~ ' B') %}{% endif %}{% if d.shm %}{% set _ = sc.append('SHM ' ~ '{:,}'.format(d.shm.size) ~ ' B') %}{% endif %}{% if d.journal %}{% set _ = sc.append('journal ' ~ '{:,}'.format(d.journal.size) ~ ' B') %}{% endif %}{{ sc|join(' · ') if sc else '—' }}</td><td>{{ badge('VALID' if d.open_status=='ok' else ('UNVERIFIED' if d.open_status in ('encrypted_suspect','not_preserved') else 'INVALID')) }} {{ d.open_status }}</td><td>{{ badge(d.integrity) }}</td><td>{{ d.page_size|cell }}{% if d.sqlite_version %}<br><span class="hash">last written by SQLite {{ d.sqlite_version }}{% if d.sqlite_version_reliable is sameas false %} (may be stale){% endif %}</span>{% endif %}</td><td>{{ d.journal_mode|cell }}{% if d.view_includes_wal %} (WAL applied{% if d.wal_frames_valid %}: {{ d.wal_frames_valid }} valid frame(s){% endif %}){% endif %}</td><td>{{ d.tables }}</td><td>{{ d.artifacts }}</td><td class="note">{{ (d.sqlite_status_detail or '')[:160] }}{% if d.open_error %}<br>{{ d.open_error[:160] }}{% endif %}{% for w in d.warnings %}<br>{{ w[:200] }}{% endfor %}</td></tr>{% endfor %}
</tbody></table></div></section>

<section id="s6"><h2><span class="n">6</span>Artifact summary</h2>
<div class="glance">{% for t,n in r.artifact_summary.by_type.items() %}<div class="card"><div class="l">{{ t }}</div><div class="v">{{ '{:,}'.format(n) }}</div></div>{% endfor %}</div>
<h3>By application</h3>
<table><thead><tr><th>Package</th><th>Application</th><th>Artifacts</th></tr></thead><tbody>
{% for a in r.artifact_summary.by_application %}<tr><td>{{ a.application }}</td><td>{{ a.name|cell }}</td><td>{% for t,n in a.counts.items() %}{{ t }}: {{ n }}{% if not loop.last %} · {% endif %}{% endfor %}</td></tr>{% endfor %}
</tbody></table></section>

<section id="s7"><h2><span class="n">7</span>Recovered deleted data</h2>
{% if r.recovery.stages_run.recover %}
<p class="lead">Records reconstructed from freed cells, released pages, stale page images and WAL/journal history. Status, confidence and its explanation come from the deterministic scorer (section 14); a CORRUPTED row is one whose structure was recoverable but whose content failed validation. A column the bytes did not determine is never guessed — it is absent and named under "unknown".</p>
{% set recon = r.recovery.recovered + r.recovery.corrupted %}
{% if recon %}
<input class="filter" placeholder="Filter recovered records…" oninput="ftab(this,'t-rec')">
<div class="scroll"><table id="t-rec"><thead><tr><th>Status</th><th>Table</th><th>Rowid</th><th>Method</th><th>Region</th><th>Unknown</th><th>Confidence</th><th>Explanation</th><th>Also found at</th></tr></thead><tbody>
{% for row in recon %}<tr><td>{{ badge(row.status) }}</td><td>{{ row.table }}</td><td class="nw">{{ row.rowid if row.rowid is not none else 'unknown' }}</td><td class="nw">{{ row.method }}</td><td>{{ row.region }}</td><td class="hash">{{ row.unknown_columns|join(', ') }}</td><td>{{ badge(row.confidence) }}</td><td>{{ row.explanation }}</td><td class="hash">{{ row.also_found_at|join('; ') }}</td></tr>{% endfor %}
</tbody></table></div>
{% else %}<p class="note">No records were recovered from this evidence.</p>{% endif %}
{% else %}
<div class="na-box"><strong>NOT PERFORMED (Review 2).</strong> {{ r.recovery.messages.recovered }}</div>
{% endif %}
<h3>Recovery-potential indicators</h3>
<p class="lead">Facts read from database headers and sidecar files. They indicate where recovery should look; they are <strong>not findings</strong> on their own, and their absence does not prove that nothing was deleted.</p>
<div class="scroll"><table><thead><tr><th>Database</th><th>Freelist pages</th><th>Header page count</th><th>WAL frame slots</th><th>Journal bytes</th><th>Indicators</th></tr></thead><tbody>
{% for i in r.recovery.indicators %}<tr><td>{{ i.path }}</td><td>{{ i.freelist_pages|cell }}</td><td>{{ i.page_count|cell }}</td><td>{{ i.wal_frame_slots|cell }}</td><td>{{ i.journal_bytes|cell }}</td><td>{% for n in i.notes %}{{ n }}{% if not loop.last %}<br>{% endif %}{% endfor %}</td></tr>{% endfor %}
</tbody></table></div>
<h3>Unrecoverable data</h3>
{% if r.recovery.stages_run.recover %}
{% if r.recovery.unrecoverable %}
<p class="lead">Freed space proven to have held a record (or a page of them), whose bytes hold nothing recoverable — proof that data existed, not a record of what it was.</p>
<div class="scroll"><table><thead><tr><th>Source</th><th>Region</th><th>Reason</th></tr></thead><tbody>
{% for u in r.recovery.unrecoverable %}<tr><td>{{ u.source_path }}</td><td>{{ u.region }}</td><td>{{ u.reason }}</td></tr>{% endfor %}
</tbody></table></div>
{% else %}<p class="note">No unrecoverable region was recorded.</p>{% endif %}
{% else %}<div class="na-box">{{ r.recovery.messages.unrecoverable }}</div>{% endif %}
</section>

<section id="s8"><h2><span class="n">8</span>Active data</h2>
<p class="lead">Records present in the live database view. Every row shows its provenance: evidence file, table, rowid, file SHA-256 and whether committed WAL frames were included. Hover a provenance cell for full detail.</p>
{% for key, sec in r.active.items() %}{% if sec.total %}
<h3>{{ sec.title }} <span class="badge b-none">{{ '{:,}'.format(sec.total) }}</span></h3>
<input class="filter" placeholder="Filter {{ sec.title|lower }}…" oninput="ftab(this,'t-{{ key }}')">
<div class="scroll"><table id="t-{{ key }}"><thead><tr>{% for c in sec.columns %}<th>{{ c }}</th>{% endfor %}<th>Provenance</th></tr></thead><tbody>
{% for row in sec.rows[:r.html_row_cap] %}<tr{% if row.marked_deleted %} class="del"{% endif %}>{% for c in row.cells %}<td{% if loop.index <= 2 %} class="nw"{% endif %}>{{ c|cell }}</td>{% endfor %}<td>{{ prov(row.prov) }}{% for f in row.flags %}<br><span class="flag">⚠ {{ f }}</span>{% endfor %}</td></tr>{% endfor %}
</tbody></table></div>{{ trunc(key) }}
{% endif %}{% endfor %}</section>

<section id="s9"><h2><span class="n">9</span>Partial recoveries</h2>
{% if r.recovery.stages_run.recover %}
{% if r.recovery.partial %}
<p class="lead">Part of the record's bytes were overwritten before recovery — typically the payload size and rowid, when a freed cell bordered the freeblock chain. Every column the surviving bytes still determine is shown; each missing one is named explicitly.</p>
<input class="filter" placeholder="Filter partial recoveries…" oninput="ftab(this,'t-partial')">
<div class="scroll"><table id="t-partial"><thead><tr><th>Table</th><th>Method</th><th>Region</th><th>Unknown columns</th><th>Confidence</th><th>Explanation</th></tr></thead><tbody>
{% for row in r.recovery.partial %}<tr><td>{{ row.table }}</td><td class="nw">{{ row.method }}</td><td>{{ row.region }}</td><td class="hash">{{ row.unknown_columns|join(', ') }}</td><td>{{ badge(row.confidence) }}</td><td>{{ row.explanation }}</td></tr>{% endfor %}
</tbody></table></div>
{% else %}<p class="note">No partial recoveries in this evidence.</p>{% endif %}
{% else %}<div class="na-box"><strong>NOT PERFORMED (Review 2).</strong> {{ r.recovery.messages.partial }}</div>{% endif %}
</section>

<section id="s10"><h2><span class="n">10</span>Carved candidates</h2>
{% if r.recovery.stages_run.carve %}
<p class="lead"><strong>Every row here is an unconfirmed candidate</strong> — a pattern match in raw bytes, status literally <code>CARVED CANDIDATE</code>, never presented as evidence. Confidence, once scored by correlation, is capped below HIGH and stays LOW without independent corroboration.</p>
{% if r.recovery.carved %}
<input class="filter" placeholder="Filter carved candidates…" oninput="ftab(this,'t-carved')">
<div class="scroll"><table id="t-carved"><thead><tr><th>Status</th><th>Kind</th><th>Matched</th><th>Container</th><th>Confidence</th><th>Explanation</th><th>Corroborated by</th></tr></thead><tbody>
{% for c in r.recovery.carved %}<tr><td>{{ badge('CARVED CANDIDATE') }}</td><td>{{ c.kind }}</td><td class="hash">{{ (c.matched or '')[:120] }}</td><td>{{ c.container }}</td><td>{{ badge(c.confidence) }}</td><td>{{ c.explanation|cell }}</td><td>{{ c.corroborated_by|length }}</td></tr>{% endfor %}
</tbody></table></div>
{% else %}<p class="note">No carved candidates in this evidence.</p>{% endif %}
{% else %}<div class="na-box"><strong>NOT PERFORMED (Review 2).</strong> {{ r.recovery.messages.carved }}</div>{% endif %}
</section>

<section id="s11"><h2><span class="n">11</span>Timeline</h2>
<p class="lead">Chronological (UTC). Artifact events carry their state; file events are filesystem metadata, not evidence of user activity. Recovered events will be visually distinct in Review 2.</p>
<input class="filter" placeholder="Filter timeline…" oninput="ftab(this,'t-tl')">
<div class="scroll"><table id="t-tl"><thead><tr><th>Timestamp (UTC)</th><th>State</th><th>Type</th><th>Event</th><th>Source</th><th>Time basis</th><th>Conf.</th></tr></thead><tbody>
{% for e in r.timeline[:r.html_row_cap] %}<tr><td class="mono nw">{{ e.ts_utc }}</td><td>{{ badge(e.status or 'FILE') }}</td><td>{{ e.artifact_type or 'file' }}</td><td>{{ e.event }}</td><td class="hash">{{ e.source }}</td><td class="hash">{{ e.time_basis|cell }}</td><td>{{ e.confidence|cell }}</td></tr>{% endfor %}
</tbody></table></div>{{ trunc('timeline') }}</section>

<section id="s12"><h2><span class="n">12</span>Correlation findings</h2>
{% if r.recovery.stages_run.correlate %}
{% if r.recovery.correlations %}
<p class="lead">Edges of the evidence graph: <code>source --relation--&gt; target</code>. A recovered record or carved candidate is corroborated only by an artifact of another kind in another database (never the same file's own data seen twice).</p>
<input class="filter" placeholder="Filter correlations…" oninput="ftab(this,'t-corr')">
<div class="scroll"><table id="t-corr"><thead><tr><th>Source</th><th>Relation</th><th>Target</th><th>Explanation</th></tr></thead><tbody>
{% for e in r.recovery.correlations %}<tr><td class="hash">{{ e.source }}</td><td>{{ e.relation }}</td><td class="hash">{{ e.target }}</td><td>{{ e.explanation }}</td></tr>{% endfor %}
</tbody></table></div>
{% else %}<p class="note">No correlation edges in this evidence.</p>{% endif %}
{% else %}<div class="na-box"><strong>NOT PERFORMED (Review 2).</strong> {{ r.recovery.messages.correlation }}</div>{% endif %}
</section>

<section id="s13"><h2><span class="n">13</span>Validation results</h2>
<div class="glance">{% for s in ['VALID','PARTIAL','INVALID','UNVERIFIED'] %}<div class="card"><div class="l">{{ s }}</div><div class="v">{{ r.validation.by_status.get(s,0) }}</div></div>{% endfor %}</div>
<p class="lead">Failed and partial checks are retained with their explanation. Per-artifact anomaly rows are included.</p>
<input class="filter" placeholder="Filter validation…" oninput="ftab(this,'t-val')">
<div class="scroll"><table id="t-val"><thead><tr><th>Status</th><th>Check</th><th>Target</th><th>Explanation</th></tr></thead><tbody>
{% for v in r.validation.results[:r.html_row_cap] %}<tr><td>{{ badge(v.status) }}</td><td>{{ v.check_name }}</td><td>{{ v.target_type }}: {{ v.target_label }}</td><td>{{ v.detail }}</td></tr>{% endfor %}
</tbody></table></div>{{ trunc('validation') }}</section>

<section id="s14"><h2><span class="n">14</span>Recovery methodology</h2>
<ul class="tight">{% for t, body in r.methodology %}<li><strong>{{ t }}.</strong> {{ body }}</li>{% endfor %}</ul></section>

<section id="s15"><h2><span class="n">15</span>Limitations</h2>
<div class="disc">{{ r.disclaimer }}</div>
<ul class="tight">{% for l in r.limitations %}<li>{{ l }}</li>{% endfor %}</ul></section>

<section id="s16"><h2><span class="n">16</span>Appendix</h2>
<h3>A. Skipped / flagged entries</h3>
{% if r.scan_issues %}<div class="scroll"><table><thead><tr><th>Stage</th><th>Issue</th><th>Path</th><th>Detail</th></tr></thead><tbody>{% for i in r.scan_issues %}<tr><td>{{ i.stage }}</td><td>{{ i.issue_type }}</td><td>{{ i.path }}</td><td>{{ i.detail }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="note">None.</p>{% endif %}
<h3>B. SQLite table catalogue</h3>
<input class="filter" placeholder="Filter tables…" oninput="ftab(this,'t-cat')">
<div class="scroll"><table id="t-cat"><thead><tr><th>Database</th><th>Table</th><th>Rows</th><th>Recognised as</th><th>Columns</th><th>Primary key · indexes</th></tr></thead><tbody>
{% for t in r.table_catalog %}<tr><td>{{ t.database.rsplit('/',1)[-1] }}</td><td>{{ t.name }}</td><td>{{ t.row_count|cell }}</td><td>{% if t.parsed_by %}{{ t.parsed_by }} <span class="hash">({{ t.schema_variant }}, {{ t.schema_score }})</span>{% else %}—{% endif %}{% if t.read_error %}<br><span class="flag">{{ t.read_error }}</span>{% endif %}</td><td class="hash">{{ t.columns|join(', ') }}</td><td class="hash">{% if t.flags %}{{ t.flags|join(' · ') }}<br>{% endif %}{% if t.primary_key %}PK({{ t.primary_key|join(', ') }}){% else %}no primary key{% endif %}{% for i in t.indexes %}<br>{{ 'UNIQUE ' if i.unique }}{{ 'partial ' if i.partial }}index {{ i.name }}({{ i.columns|join(', ') }}){% endfor %}{% for f in t.foreign_keys %}<br>FK({{ f.columns|join(', ') }}) → {{ f.references }}{% endfor %}</td></tr>{% endfor %}
</tbody></table></div>
<h3>C. Chain of custody</h3>
<p>{{ badge('VALID' if r.custody.intact else 'INVALID') }} {{ r.custody.message }}. Each entry commits to the hash of the previous one.</p>
<div class="scroll"><table><thead><tr><th>#</th><th>Time (UTC)</th><th>Actor</th><th>Action</th><th>Target</th><th>Entry hash</th></tr></thead><tbody>
{% for c in r.custody.entries %}<tr><td>{{ c.id }}</td><td class="mono nw">{{ c.ts }}</td><td>{{ c.actor }}</td><td>{{ c.action }}</td><td>{{ c.target|cell }}</td><td class="hash">{{ c.entry_hash[:20] }}…</td></tr>{% endfor %}
</tbody></table></div>
<h3>D. Analysis runs</h3>
<table><thead><tr><th>#</th><th>Stage</th><th>Status</th><th>Started</th><th>Finished</th><th>Tool</th></tr></thead><tbody>{% for u in r.runs %}<tr><td>{{ u.id }}</td><td>{{ u.stage }}</td><td>{{ u.status }}</td><td class="mono nw">{{ u.started_at }}</td><td class="mono nw">{{ u.finished_at|cell }}</td><td>{{ u.tool_version }}</td></tr>{% endfor %}</tbody></table>
<h3>E. Status glossary</h3>
<table><tbody>{% for k,v in r.status_glossary %}<tr><td><strong>{{ k }}</strong></td><td>{{ v }}</td></tr>{% endfor %}</tbody></table>
<h3>F. Verifying this evidence independently</h3>
<p>Recompute the SHA-256 of any original file (for example <code>shasum -a 256 &lt;file&gt;</code>) and compare it with section 4 or <code>evidence_manifest.json</code>. The hashes of the report files themselves are listed in <code>sha256sums.txt</code> beside this report.</p>
</section>
</main></div>
<script>
function ftab(input,id){var q=input.value.toLowerCase(),rows=document.querySelectorAll('#'+id+' tbody tr');for(var i=0;i<rows.length;i++){rows[i].style.display=rows[i].textContent.toLowerCase().indexOf(q)>-1?'':'none'}}
</script>
</body></html>
